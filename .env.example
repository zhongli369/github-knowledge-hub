# ─────────────────────────────────────────────────────────────────────
# GitHub Knowledge Hub — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Database (required) ─────────────────────────────────────────────
# PostgreSQL 17 with pgvector extension.
# 启动：docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/github_knowledge_hub?schema=public"

# ── Auth.js (required for login) ────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Override in production; defaults to http://localhost:3000 in dev.
# AUTH_URL="http://localhost:3000"

# Create a GitHub OAuth app at https://github.com/settings/developers/new
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── GitHub API (optional — used for repo sync in Phase 3) ───────────
# Falls back to the user's OAuth access token from Auth.js if empty.
# Set this for a machine token with higher rate limits (optional).
GITHUB_TOKEN=""

# ── OpenAI (optional — Phase 5, not yet enabled) ────────────────────
# Required for LLM analysis and semantic embeddings.
# Leave empty for now — Phase 1–4 do not depend on it.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"          # optional, defaults to gpt-4o-mini
# EMBEDDING_MODEL="text-embedding-3-small"  # optional
