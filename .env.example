# ─────────────────────────────────────────────────────────────────────
# GitHub Knowledge Hub — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Database (required) ─────────────────────────────────────────────
# PostgreSQL 17 with pgvector extension.
# 启动：docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/github_knowledge_hub?schema=public"

# ── Auth.js (required for login) ────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Override in production; defaults to http://localhost:3000 in dev.
# AUTH_URL="http://localhost:3000"

# Create a GitHub OAuth app at https://github.com/settings/developers/new
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── OAuth token encryption (required for new Account writes) ───────
# Base64-encoded 32-byte key. Generate once and keep it stable across restarts:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# New OAuth token writes fail closed when this key is missing or invalid.
TOKEN_ENCRYPTION_KEY=""
# During rotation only: previous base64 32-byte key, used for decryption only.
# Keep it until all ciphertext using the old key has been re-encrypted.
# TOKEN_ENCRYPTION_KEY_PREV=""

# ── GitHub API (optional machine token) ─────────────────────────────
# Business code normally uses the current user's OAuth Account token.
# Keep empty unless a machine token is explicitly wired into a workflow.
GITHUB_TOKEN=""

# ── OpenAI-compatible LLM and Embedding providers (optional) ───────
# Required only for AI summaries, asset analysis and semantic search.
OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
# EMBEDDING_API_KEY=""       # defaults to OPENAI_API_KEY when empty
# EMBEDDING_BASE_URL=""      # defaults to OPENAI_BASE_URL when empty
# EMBEDDING_MODEL is documentary only; the current code uses text-embedding-3-small.

# ── Automation scheduler (optional) ──────────────────────────────
# Tuning for `npm run worker:automation`. The worker is idle-safe and backs
# off automatically; these only tune the cadence.
# AUTOMATION_POLL_INTERVAL_MS="10000"   # poll cadence (ms), floor 1000
# AUTOMATION_LEASE_MS="900000"           # lease per scheduled run (ms), floor 60000
# WORKER_ID=""                           # optional stable worker identity
