generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ── Auth.js Tables ──────────────────────────────────────────────

model User {
  id                        String                     @id @default(cuid())
  name                      String?
  email                     String?                    @unique
  emailVerified             DateTime?
  image                     String?
  githubUsername            String?                    @unique
  accounts                  Account[]
  sessions                  Session[]
  repositories              Repository[]
  analyses                  Analysis[]
  collections               Collection[]
  repositoryClassifications RepositoryClassification[]
  knowledgeAssets           KnowledgeAsset[]
  automationSettings        AutomationSettings?
  syncRuns                  SyncRun[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain Tables ───────────────────────────────────────────────

model Repository {
  id              String                    @id @default(cuid())
  githubId        Int
  owner           String
  name            String
  fullName        String
  description     String?
  url             String
  homepage        String?
  language        String?
  stars           Int                       @default(0)
  forks           Int                       @default(0)
  topics          String[]
  defaultBranch   String                    @default("main")
  isArchived      Boolean                   @default(false)
  isTemplate      Boolean                   @default(false)
  license         String?
  size            Int                       @default(0)
  pushedAt        DateTime?
  lastFetchedAt   DateTime                  @default(now())
  headSha         String?
  syncHash        String?
  starredAt       DateTime?
  unstarredAt     DateTime?
  note            String?
  status          String                    @default("new") // "new", "analyzing", "active", "archived"
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeAssets KnowledgeAsset[]
  analyses        Analysis[]
  repoEmbedding   RepoEmbedding?
  collectionLinks CollectionRepository[]
  classification  RepositoryClassification?
  // Stored generated column; its expression is managed in migration 20261103231000.
  searchVector    Unsupported("tsvector")?  @default(dbgenerated())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([userId, githubId])
  @@unique([userId, fullName])
  @@index([userId])
  @@index([language])
  @@index([stars])
  @@index([searchVector], type: Gin)
}

model KnowledgeAsset {
  id           String            @id @default(cuid())
  title        String
  description  String?
  assetType    String // "algorithm", "pattern", "snippet", "architecture", "config", "doc"
  sourcePath   String? // file path within the repo
  sourceUrl    String?
  sourceSha    String?
  contentHash  String?
  content      String // extracted source text
  summary      String? // LLM-generated summary
  language     String?
  tags         String[]
  difficulty   String? // "beginner", "intermediate", "advanced"
  usefulness   Int               @default(0)
  repositoryId String
  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  embedding    Embedding?
  collections  CollectionAsset[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([repositoryId, sourcePath])
  @@index([userId])
  @@index([repositoryId])
  @@index([assetType])
  @@index([language])
}

model Embedding {
  id        String                      @id @default(cuid())
  assetId   String                      @unique
  asset     KnowledgeAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vector    Unsupported("vector(1536)")
  model     String                      @default("text-embedding-3-small")
  createdAt DateTime                    @default(now())
}

model RepoEmbedding {
  id           String                      @id @default(cuid())
  repositoryId String                      @unique
  repository   Repository                  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  vector       Unsupported("vector(1536)")
  model        String                      @default("text-embedding-3-small")
  textHash     String // SHA256 of source text for change detection
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model Collection {
  id           String                 @id @default(cuid())
  name         String
  slug         String?
  kind         String                 @default("custom") // "custom", "category"
  description  String?
  isPublic     Boolean                @default(false)
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets       CollectionAsset[]
  repositories CollectionRepository[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, kind])
}

model CollectionAsset {
  id           String         @id @default(cuid())
  collectionId String
  assetId      String
  addedAt      DateTime       @default(now())
  sortOrder    Int            @default(0)
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  asset        KnowledgeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([collectionId, assetId])
}

model CollectionRepository {
  id           String     @id @default(cuid())
  collectionId String
  repositoryId String
  source       String     @default("auto") // "auto", "manual"
  excluded     Boolean    @default(false)
  confidence   Float?
  reason       String?
  addedAt      DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([collectionId, repositoryId])
  @@index([collectionId, excluded])
  @@index([repositoryId, excluded])
}

model RepositoryClassification {
  repositoryId      String     @id
  userId            String
  contentHash       String
  classifierVersion String
  status            String // "classified", "unclassified", "failed"
  categorySlugs     String[]   @default([])
  error             String?
  classifiedAt      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  repository        Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Analysis {
  id              String      @id @default(cuid())
  analysisType    String // "repo_summary", "code_review", "pattern_extraction", "dependency_analysis", "similarity_search"
  status          String      @default("pending") // "pending", "running", "completed", "failed"
  input           Json?
  result          Json?
  error           String?
  model           String? // LLM model used
  tokensUsed      Int         @default(0)
  durationMs      Int         @default(0)
  sourceSha       String?
  contentHash     String?
  repositoryId    String?
  repository      Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  similarAssetIds String[]    @default([])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // ── Worker leasing (P1 Agent B) ────────────────────────────────
  // Identity of the worker that currently owns the task lease.
  workerId       String?
  // When the current lease was acquired by the owning worker.
  claimedAt      DateTime?
  // Lease expiry. A "running" task with a past lease is reclaimable.
  leaseExpiresAt DateTime?
  // Number of times the task has been claimed; bounded by worker MAX_ATTEMPTS.
  attempts       Int       @default(0)

  // A partial unique index on (repositoryId, userId, analysisType) for
  // pending/running rows is managed in migration 20261104190000. Prisma's
  // schema format does not model partial indexes.
  @@index([userId])
  @@index([status])
  @@index([analysisType])
  @@index([status, leaseExpiresAt])
}

// ── P3 auto-sync ──────────────────────────────────────────────────
// Shared scheduling / sync-providence contract consumed by the incremental
// sync service, the scheduler/worker and the AI "auto-analyze" feature.

model AutomationSettings {
  id              String    @id @default(cuid())
  userId          String    @unique
  enabled         Boolean   @default(false)
  autoAnalyze     Boolean   @default(true)
  intervalMinutes Int       @default(60)
  nextSyncAt      DateTime  @default(now())
  leaseExpiresAt  DateTime?
  workerId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scheduler scan: "enabled AND due" without scanning disabled/non-due rows.
  @@index([enabled, nextSyncAt])
}

model SyncRun {
  id                  String    @id @default(cuid())
  userId              String
  trigger             String // "manual" | "scheduled"
  status              String // "running" | "completed" | "failed"
  totalCount          Int       @default(0)
  processedCount      Int       @default(0)
  addedCount          Int       @default(0)
  updatedCount        Int       @default(0)
  unchangedCount      Int       @default(0)
  unstarredCount      Int       @default(0)
  failedCount         Int       @default(0)
  analysisQueuedCount Int       @default(0)
  error               String?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A partial unique index on (userId) for running rows is managed in
  // migration 20261105120001_p3_auto_sync. Prisma's schema format does not
  // model partial indexes.
  @@index([userId, createdAt])
  @@index([status])
}
